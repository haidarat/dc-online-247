# Environment variables — copy this file to .env and fill in your values
# cp .env.example .env

# Discord user token (NOT a bot token)
token=YOUR_DISCORD_USER_TOKEN_HERE

# Discord Server (Guild) ID
server=YOUR_GUILD_ID_HERE

# Voice Channel ID to join
id=YOUR_VOICE_CHANNEL_ID_HERE

# HTTP Health Server port (optional, default: 3500)
PORT=3500
