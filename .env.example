# Environment variables — copy this file to .env and fill in your values
# cp .env.example .env

# Discord credential. Keep the real value only in .env locally or Render's
# Environment settings. Never add it to Git, logs, screenshots, or issues.
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE

# Discord Server (Guild) ID
GUILD_ID=YOUR_GUILD_ID_HERE

# Voice Channel ID to join
VOICE_CHANNEL_ID=YOUR_VOICE_CHANNEL_ID_HERE

# HTTP server port (Render supplies PORT automatically; default: 3500 locally)
PORT=3500
